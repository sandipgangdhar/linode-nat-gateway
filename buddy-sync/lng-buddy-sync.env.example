# lng-buddy-sync.env.example (buddy-sync)
#
# Reference for every environment variable buddy_sync.py reads. Not
# consumed directly in normal operation -- both deployment paths generate
# the real /etc/lng-buddy-sync/env file automatically.
#
# -----------------------------------------------------
# Usage:
#
# - Terraform floor nodes: written by
#   ansible/cloud-init/nat-node.yaml.tftpl.
# - natctl-provisioned elastic nodes: written by
#   controller/natctl/cloud_init.py.
# - Use this file only as a reference, or to manually bring up buddy-sync
#   on a node outside either path.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------

# See buddy_sync.py for what each of these controls. On a Terraform floor
# node these are all filled in automatically by
# ansible/cloud-init/nat-node.yaml.tftpl; on a natctl-provisioned elastic
# node, by controller/natctl/cloud_init.py. This file is only useful as a
# reference or for manually bringing up a node outside either path.

NATCTL_ROSTER_URL=http://10.0.0.5:8099/fleet/shared
NAT_NODE_ID=shared-1
NAT_PRIVATE_IP=10.0.0.20
LNG_BUDDY_POLL_INTERVAL=20
# v5: set true only for pools with ip_failover_enabled -- see
# docs/ARCHITECTURE.md section 3.6/3.6.1. Leave false/unset otherwise; FRR
# won't even be installed on nodes in pools that don't use it.
NAT_IP_FAILOVER_ENABLED=false
# This node's own public (eth0) IP -- self-detected and appended by the
# boot-time runcmd step (see ansible/cloud-init/nat-node.yaml.tftpl /
# controller/natctl/cloud_init.py), not set here directly. Only relevant
# when NAT_IP_FAILOVER_ENABLED=true.
NAT_PUBLIC_IP=
