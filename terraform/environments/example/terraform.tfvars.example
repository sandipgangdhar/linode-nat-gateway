# terraform.tfvars.example (terraform/environments/example)
#
# Sample values for every required/commonly-changed variable in this
# example environment. Copy this file to terraform.tfvars (which is
# gitignored) and fill in real values before running terraform apply.
#
# -----------------------------------------------------
# Usage:
#
# Create a VPC + subnet yourself first (see "Bring your own VPC" below).
# cp terraform.tfvars.example terraform.tfvars
# # edit terraform.tfvars: ssh key, region, vpc_id, public_subnet_id
# sops secrets.enc.json   # fill in linode_token, root_pass,
#                          # grafana_admin_password, natctl_object_storage_*
#                          # (secrets.enc.json is already checked into this
#                          # repo, SOPS+age encrypted -- editing it requires
#                          # an age private key that can decrypt it; see
#                          # docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html, Part
#                          # VIII 8.3 to generate your own and get it added
#                          # as a recipient)
# terraform init && terraform apply
#
# -----------------------------------------------------
# Best Practices:
#
# - Never commit the real terraform.tfvars (only this .example file is
#   meant to be checked in) -- it may contain non-secret operational
#   values you don't want to share.
# - linode_token, root_pass, grafana_admin_password, and the
#   natctl_object_storage_* keys no longer live here at all -- they live
#   in secrets.enc.json (SOPS + age encrypted, safe to commit as
#   ciphertext) and are read in-memory at plan/apply time via
#   data.sops_file.secrets in main.tf. See
#   docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html, Part VIII 8.3 for the full
#   workflow, including how to onboard a second operator.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------

# Copy to terraform.tfvars and fill in.

# linode_token moved to secrets.enc.json -- see the header comment above.
region        = "us-east"

# Prefix for every resource this environment creates whose name is
# otherwise fixed (module.vpc's three Cloud Firewalls). Change this to
# run a second, clearly-distinguishable copy of this environment in the
# same account/region with no naming collision. Defaults to "lng-example"
# -- uncomment only if you need a different value.
# label = "lng-example"

# --------------------------------------------------------------------------
# Bring your own VPC -- REQUIRED. This automation does not create the
# VPC or its subnet(s) itself (see terraform/modules/vpc/main.tf's
# header comment). Create these first yourself, e.g. via linode-cli:
#
#   linode-cli vpcs create --label lng-example --region us-east
#   linode-cli vpcs subnets-create <vpc_id> --label public-nat --ipv4 10.0.0.0/24
#
# public_subnet_id's CIDR needs enough headroom for every pool's
# private_ip_offset range COMBINED -- 10.0.0.0/24 comfortably fits this
# example's two pools (common starts at .20, acme at .50).
# --------------------------------------------------------------------------
vpc_id           = 0 # REPLACE_ME with your VPC's numeric id
public_subnet_id = 0 # REPLACE_ME with your public subnet's numeric id

# Optional: only if some OTHER VPC-resident workload (e.g. an LKE
# Enterprise cluster's own private subnet) needs to reach natctl's roster
# API (port 8099) on the observability/control-plane host. This is a
# Cloud-Firewall concern, not a routing one -- terraform/modules/vpc/
# main.tf's control_plane firewall is default-deny (inbound_policy =
# "DROP"), so a subnet not listed here still gets its inbound connections
# to 8099 dropped. Listing a subnet's id below adds its real CIDR to that
# one firewall rule's allowlist (see data.linode_vpc_subnet.private + the
# natctl-api inbound block in that file) -- nothing else. It does NOT
# affect the NAT client fleet (that runs over VLAN, not VPC, since VPC
# cannot transit-route to a non-VPC destination -- see
# docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html §1.2) and does NOT add the subnet to the nat_node
# firewall. Leave as {} (the default) if nothing outside the
# NAT/observability nodes themselves needs to call that API.
#
# Linode does NOT automatically route a VPC-attached instance to
# any OTHER subnet in the same VPC -- only its own directly-connected one
# gets a kernel route; everything else falls through to the default
# route (out the PUBLIC interface, not the VPC) and is silently dropped,
# even once Cloud Firewall allows it here. This project fixes that
# separately and automatically (every subnet in the VPC is auto-
# discovered via linode_vpc_subnets and routed into every node's eth1 --
# see terraform/modules/vpc's all_subnet_cidrs output) -- you do not need
# to do anything extra for routing itself, only decide which subnets
# should be allowed through the firewall, which is what private_subnet_ids
# below still controls.
# private_subnet_ids = {
#   "private-app-1" = 0 # REPLACE_ME
#   "private-app-2" = 0 # REPLACE_ME
# }

authorized_keys = [
  "ssh-ed25519 AAAA... you@example.com",
]

# root_pass and grafana_admin_password moved to secrets.enc.json -- see the
# header comment above.

# --------------------------------------------------------------------------
# REQUIRED -- no default, deliberately. Every
# firewall this environment creates (nat_node, control_plane, client) scopes
# SSH to exactly these CIDRs, and control_plane also scopes Grafana/
# Prometheus/Alertmanager (3000/9090/9093) to them. This used to default to
# 0.0.0.0/0 (open to the entire internet) with only a code comment telling
# an operator to fix it -- now you must set it explicitly. Use your own
# admin/office/VPN egress CIDR(s), e.g. a single IP as a /32.
# --------------------------------------------------------------------------
admin_cidrs = ["REPLACE_ME/32"] # e.g. ["203.0.113.4/32"]

# --------------------------------------------------------------------------
# Pools -- every NAT-fleet pool this environment provisions. See
# variables.tf's pools description for the full field-by-field
# breakdown. This example shows two pools sharing ONE physical VLAN
# ("same-VLAN mode" -- both pools' vlan_label values match): "common", the
# default pool every tenant uses unless assigned elsewhere, and "acme", a
# tenant needing isolated capacity. Add a third pool (on this same VLAN
# or a genuinely separate one) by adding another entry to this map --
# main.tf never needs touching for that. Remove "acme" entirely if you
# only need one pool.
#
# YOU DO NOT CHOOSE ANY ADDRESSES. Each pool below states only what it is:
# how many nodes (floor_nodes / max_nodes), which plan, and which VLAN.
# Terraform works out every address from that -- the VPC address of each
# floor, elastic and witness node, the block of the VLAN the pool owns, and
# where inside it each kind of node goes -- packs the pools so they cannot
# overlap, and prints the result as the `pool_address_plan` output on every
# plan. Read that output, and hand each VLAN's client range to whoever numbers
# your client instances: the gateway fleet uses the ranges listed as
# reserved_for_the_gateway_fleet, and one more block -- as large as any fleet's
# -- is kept free as reserved_for_future_fleets, so you can add a dedicated fleet
# tomorrow without renumbering any client. Clients may use the VLAN from
# client_addresses_start_at (configure them as configure_clients_with, that
# address plus the VLAN's prefix length). Nothing is held back on the VPC side:
# Linode offers no way to reserve VPC addresses.
#
# How the calculation places pools (details: docs/NAT-GATEWAY-DEFINITIVE-
# GUIDE.html, Part IX, "Planning pool addresses"):
#   - Pools take slots in the sorted order of their names -- in this
#     example "acme" is slot 0 and "common" is slot 1. A pool's own node
#     counts never move any other pool.
#   - Every pool can grow to 32 floor nodes and 31 elastic nodes before it
#     needs a bigger block (pool_vpc_block_size), and to 56 floor nodes and
#     63 elastic nodes inside its VLAN block (pool_vlan_reserved_prefix).
#   - When you ADD a pool whose name sorts before an existing one, pin it
#     with `slot = <next unused number>` so the existing pools do not move;
#     the plan shows any node replacement, so a mistake is visible.
#
# Every pool's addresses -- calculated or overridden -- are checked at
# `terraform plan` time, and a problem STOPS the plan with a message naming
# the pools involved: overlapping ranges on the shared VPC subnet or on a
# shared VLAN, a pool that does not fit its block, a duplicate slot.
#
# OPTIONAL ADVANCED OVERRIDES -- leave all of these out unless a pool must
# sit at specific addresses (for example to match addresses your firewall
# or routing already refer to). Each one replaces only its own calculated
# value; everything else stays calculated, and the result is checked exactly
# like a calculated layout. They are shown, commented out, on the "acme"
# pool below. What each one means:
#   slot                        Which slot of the shared VPC subnet (and,
#                               among pools on one VLAN, which reserved
#                               block) the pool takes.
#   vlan_cidr_reserved          The block of the VLAN, nested inside
#                               vlan_cidr, that the pool's own nodes draw
#                               their VLAN addresses from. Give nothing
#                               else an address inside it.
#   private_ip_offset           First VPC host offset of the pool's floor
#                               nodes, counted from the start of
#                               public_subnet_id's CIDR. Shared by every
#                               pool, so it must be unique across pools.
#   vlan_ip_offset              First VLAN host offset of the floor nodes,
#                               counted from the start of vlan_cidr_reserved.
#                               Must be at least 2.
#   elastic_ip_offset_start     First host offset of the elastic nodes
#                               natctl adds, counted from the start of
#                               vlan_cidr_reserved. Setting only this one
#                               also uses the same number as the VPC host
#                               offset (the original behaviour).
#   vpc_elastic_ip_offset_start First VPC host offset of the elastic nodes,
#                               when it must differ from the one above.
#   witness_private_ip_offset   VPC host offset of the pool's witness node.
# --------------------------------------------------------------------------
#
# natctl_on_node_enabled defaults to true (running the control plane on
# every node instead of a dedicated host) -- see that variable's own
# comment further down for the opt-out. Under this mode, a pool's
# floor_nodes count is a real safety decision, not just a capacity one:
#   - 1 node: always its own leader by default -- no real failover, and
#     this mode buys you nothing over the single dedicated host. No
#     witness can fix this either (there's no partition-vs-dead
#     ambiguity to resolve when there's only ever one candidate).
#   - 2 nodes: the genuinely risky configuration on its own -- a real
#     network partition between exactly two nodes is indistinguishable,
#     from either side, from the other one actually being dead, so the
#     quorum-confirmation gate has no third node to ask. main.tf's
#     pool_effective_witness_enabled local closes this BY DEFAULT:
#     leaving witness_enabled unset on a 2-node pool auto-provisions a
#     real, cheap (g6-nanode-1) third voter that never forwards traffic,
#     only votes (see the common example below for the opt-OUT case,
#     and acme for an explicit opt-IN -- both produce the same result on
#     a 2-node pool). The witness's VPC address is calculated like every
#     other address, so nothing more is needed to enable one.
#   - 3+ nodes: the configuration this mode is actually designed for --
#     see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html Part II, 2.3/2.4 for the
#     full detail. Already has a real 3rd (or more) voter --
#     witness_enabled gains it nothing (and the smart default above only
#     ever triggers at exactly floor_nodes == 2, never here).
# This has no bearing on floor_nodes if you opt back into
# natctl_on_node_enabled = false -- that mode has no leader election at all.
pools = {
  common = {
    fleet_label   = "lng-common"
    floor_nodes   = 1 # start minimal, raise once real load justifies it -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html §5.1
    max_nodes     = 12
    instance_type = "g6-dedicated-4"
    vlan_label    = "lng-vlan-shared"
    vlan_cidr     = "192.168.100.0/22" # the FULL, real VLAN -- every node's interface uses THIS prefix length
    # reserved_ip_pool      = ["203.0.113.10", "203.0.113.11"] # optional -- addresses you ALREADY OWN, see variables.tf
    # --------------------------------------------------------------------
    # 2-node quorum-witness role -- only meaningful once natctl_on_node_enabled
    # = true below, and only relevant once THIS pool's own floor_nodes is
    # exactly 2 (not the current 1 above). If you raise floor_nodes to 2
    # and turn on natctl_on_node_enabled, you get a witness automatically
    # -- witness_enabled's default is smart (see main.tf's
    # pool_effective_witness_enabled), not a hardcoded false, so you do
    # not need to uncomment anything to get one. Uncomment ONLY the
    # opt-OUT line below if you've deliberately decided you don't want a
    # witness for this pool despite it being 2-node -- see
    # docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html Part II, 2.3 for what a
    # witness does before opting out of one.
    # witness_enabled = false # deliberate opt-out -- see comment above
    # --------------------------------------------------------------------
  }
  acme = {
    fleet_label   = "lng-acme"
    floor_nodes   = 2
    max_nodes     = 6
    instance_type = "g6-dedicated-8"
    vlan_label    = "lng-vlan-shared"  # SAME as common's -- same-VLAN mode. Use a different label for a genuinely separate VLAN instead.
    vlan_cidr     = "192.168.100.0/22" # SAME wide VLAN as common -- the calculation gives each pool its own block inside it
    # 2-node quorum-witness role (only meaningful once natctl_on_node_enabled
    # = true below -- see this file's own comment on floor_nodes above).
    # witness_enabled is redundant here (acme's floor_nodes == 2 means it
    # defaults to true on its own) -- left explicit anyway as a worked
    # example of the opt-IN spelling.
    witness_enabled       = true
    witness_instance_type = "g6-nanode-1" # never forwards traffic -- the cheapest generally-available type is enough
    # --------------------------------------------------------------------
    # Optional advanced overrides -- see the explanation above `pools`.
    # Uncomment only what you must place by hand; each line replaces just
    # its own calculated value. The numbers below are examples, not
    # recommendations.
    # slot                        = 1
    # vlan_cidr_reserved          = "192.168.101.0/27" # nested inside vlan_cidr, and must not overlap common's block
    # private_ip_offset           = 50                 # VPC side -- must not overlap any other pool's floor range
    # vlan_ip_offset              = 20                 # VLAN side -- counted from the start of vlan_cidr_reserved
    # elastic_ip_offset_start     = 25                 # VLAN side (and VPC side too, unless the next line is set)
    # vpc_elastic_ip_offset_start = 200                # VPC side only -- clear of every pool's floor and elastic ranges
    # witness_private_ip_offset   = 52                 # VPC side -- clear of every pool's floor and elastic ranges
    # --------------------------------------------------------------------
  }
}

# --------------------------------------------------------------------------
# BGP-based IP failover -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html
# §4.4 (and Part 0, 0.2 (g) for how BGP/IP Sharing work at all).
# Defaults TRUE: without it, a dead node's public IP simply goes dark --
# client-side ECMP reroutes NEW connections to surviving nodes, but
# nothing takes over the address itself. With it (the default), every
# buddy pair bidirectionally announces both its own and its buddy's
# public IP over BGP (FRR), so a dead node's address fails over to its
# live buddy automatically.
#
# linode_bgp_dcid is therefore REQUIRED for a working `terraform apply`
# with the defaults -- look up your region's BGP data-center id from
# Linode's current failover documentation:
#   https://techdocs.akamai.com/cloud-computing/docs/configure-failover-on-a-compute-instance
# (the table there maps each region to its numeric ID -- use the ID
# next to your own region). It is deliberately not hardcoded here since
# it's a Linode-side mapping that can change independently of this
# project. A plan/apply-time check fails loudly, by name, if this is
# left unset while ip_failover_enabled is true.
#
# Set ip_failover_enabled = false below instead if BGP IP Sharing isn't
# available in your region, or you deliberately want to run without
# this HA layer.
# --------------------------------------------------------------------------
linode_bgp_dcid = 0 # REPLACE_ME -- see variables.tf's linode_bgp_dcid description
# ip_failover_enabled = false

# Whether Terraform-managed FLOOR nodes run buddy-sync at all (default
# true). natctl-provisioned elastic nodes are governed separately by
# natctl.yaml's own PoolConfig.conntrack_buddy_sync_enabled (also
# default true) -- keep both in sync, or floor nodes keep syncing
# indefinitely after you've turned it off for elastic nodes.
# conntrack_buddy_sync_enabled = true

# Which pool's VLAN the observability host joins directly (only meaningful
# when natctl_on_node_enabled is false, below) -- see variables.tf's
# observability_vlan_pool. Must be a key in pools above, or "" to skip
# joining any VLAN entirely.
observability_vlan_pool = "common"

# Starting VPC-side host offset for the observability host's own static
# address -- see variables.tf's observability_private_ip_offset. Defaults
# to 5 (uncomment only if you need a different value). If public_subnet_id
# above is a VPC subnet ALSO used by a completely separate LNG deployment
# (different terraform.tfvars/state), and that deployment's own
# observability host also uses the default 5, your `terraform apply`
# fails outright with Linode's [400] "The provided IP is already in use
# in the subnet" -- this project's own plan-time checks can only ever see
# pools/resources within THIS terraform.tfvars, never a second
# deployment's state. Pick a value clear of that other deployment's own
# offsets if you're sharing a subnet this way.
#
# This address is also where every node's natctl looks for Prometheus
# (http://<this address>:9090). It must be the real VPC address of the host
# that runs Prometheus -- if you run Prometheus on a host this environment
# does not create, set this to that host's actual address offset, or natctl
# silently cannot read any autoscale metric.
# observability_private_ip_offset = 5

# TCP port natctl's roster API listens on -- see variables.tf's api_port
# description. Defaults to 8099 (uncomment only if you need a different
# value, e.g. it collides with something else already using 8099 on your
# network). One value for the whole environment: changing it here threads
# through automatically to every place that needs to agree on it --
# module.vpc's Cloud Firewall rule, every pool's nftables ruleset (floor
# AND natctl-provisioned elastic nodes), the observability host's own
# firewall rule, the composed natctl.yaml's api.listen_port, and the
# Prometheus file_sd scrape targets. If you change this on an already-
# deployed environment, remember every existing client's
# NATCTL_ROSTER_URL / install-nat-client.sh --roster-url and any
# natctl_cli --natctl-url you've configured still point at the OLD port
# and need updating too -- this variable does not retroactively rewrite
# URLs baked into already-provisioned clients.
# api_port = 8099

# --------------------------------------------------------------------------
# Reserved IPs -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html §4.6. Opt-in (default false). When
# true, every node's primary public IP (floor AND natctl-provisioned
# elastic nodes, every pool) is a Linode Reserved IP that survives an
# instance replacement -- turn this on if any downstream service
# IP-whitelists this fleet's egress addresses. Linode's Reserved IP
# feature is account-gated ("IP reservation is not currently available to
# all users") -- confirm it's enabled for your account before setting
# this true, or linode_networking_ip will fail outright on apply.
# --------------------------------------------------------------------------
# reserved_ip_enabled = true

# --------------------------------------------------------------------------
# Anti-affinity placement groups -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html
# §4.5. Opt-in (default false).
# When true, every pool's floor nodes are spread across Linode Placement
# Groups (anti_affinity:local) so Akamai avoids co-locating them on the
# same physical host -- closes the "correlated physical-host failure
# takes out both buddy pair members" gap that buddy conntrack sync + BGP
# IP failover alone don't cover. Floor nodes
# only -- natctl-provisioned elastic nodes are not covered. A pool over 5
# floor nodes gets multiple groups (Akamai's 5-Linode-per-group cap) in
# contiguous creation-order blocks, which only fully protects pairs that
# land inside the same block -- a structural limitation of contiguous-block
# assignment, not a bug (it minimizes rather than eliminates the exposure).
# --------------------------------------------------------------------------
# placement_group_enabled = true
# placement_group_policy  = "strict" # or "flexible" -- see variables.tf

# --------------------------------------------------------------------------
# Object Storage -- REQUIRED (not opt-in), regardless of natctl_on_node_enabled
# below. terraform/modules/artifacts uploads exporter.py/buddy_sync.py/the
# natctl package here ONCE per apply, and every NAT node fetches them at
# boot instead of embedding their content directly in cloud-init --
# Linode's Instance Metadata API hard-caps user_data at 16384 bytes
# (decoded), and this project's own source files alone already exceed
# that with no other features enabled. See docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html
# §6.2 ("Fetched-at-Boot Artifacts") and
# terraform/modules/artifacts/main.tf's header comment for the full
# numbers. The SAME bucket/keys also back the leader-election lease when
# natctl_on_node_enabled is true (see below) -- one bucket, dual purpose.
# Create the bucket yourself first (Cloud Manager, or `linode-cli
# object-storage bucket-create`) -- this project does not create it via
# Terraform.
# --------------------------------------------------------------------------
natctl_object_storage_endpoint   = "https://us-east-1.linodeobjects.com"
natctl_object_storage_bucket     = "lng-artifacts"
# natctl_object_storage_access_key and natctl_object_storage_secret_key
# moved to secrets.enc.json -- see the header comment above.

# natctl-on-node (the DEFAULT -- see variables.tf's own default) --
# removes the requirement for a dedicated
# control-plane host by running natctl itself, leader-elected with STONITH
# fencing (power off the previous leader, poll for confirmed offline,
# only then claim leadership -- see controller/natctl/leader_election.py
# and docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html §2.3/§2.4), on every NAT node
# in every pool instead. Leaving this line commented out means
# natctl_on_node_enabled is TRUE (the variable's own default) -- to get
# the ORIGINAL single-dedicated-host layout instead (module.observability
# runs natctl), uncomment the line below and set it to false explicitly.
# Read the guide's leader-election section either way -- fencing briefly
# interrupts a node's own NAT traffic, and this is defense-in-depth, not
# mathematically perfect mutual exclusion. The Object Storage block above
# it is required regardless of which mode you're in (see its own comment).
#
# Every pool's floor_nodes count above matters under this mode -- see the
# node-count warning right before the pools block -- but a 2-node pool
# now gets a witness automatically (pool_effective_witness_enabled in
# main.tf), so leaving this at its true default no longer requires you to
# also remember to set witness_enabled by hand.
#
# natctl_on_node_enabled = false # uncomment to opt back into single-dedicated-host mode

# Let already-running natctl processes pick up a fresh publish without a
# node rebuild -- an operator-triggered rolling-restart (natctl_cli's
# rolling-restart command) and a fully automatic, jittered live-reload.
# Off by default; uncomment to opt in.
# auto_update_enabled = true

# Optional runtime secrets bundle (Layer 2 of this project's SOPS+age
# secrets design -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html Part VIII
# 8.3). Off by default ("" below): natctl falls back to /etc/natctl/env
# entirely, unchanged. Turning it on means natctl fetches and decrypts
# one whole-file age-encrypted blob at its own startup instead of
# relying solely on that plaintext env file -- the matching age PRIVATE
# key comes from secrets.enc.json's own secrets_bundle_age_private_key
# field (a SEPARATE keypair from your operator SOPS key), not from here.
# This value itself is not sensitive -- it points at ciphertext, safe to
# commit -- but it only does anything once you've also generated the
# bundle keypair, filled in secrets_bundle_age_private_key, and built
# and published the bundle with scripts/build-secrets-bundle.sh.
#
# secrets_bundle_url = "https://<endpoint>/<bucket>/natctl/secrets-bundle.json.age"

# Already have Prometheus/Grafana (or a remote-write-compatible
# backend)? Set this to false to skip provisioning this project's own copy
# entirely. You
# can also keep run_monitoring_stack = true (the default) and just add
# customer_prometheus_remote_write_url to have the local Prometheus this
# environment provisions forward samples into your existing backend too.
#
# run_monitoring_stack                      = false
# customer_prometheus_remote_write_url      = "https://prometheus-blocks-prod-us-central1.grafana.net/api/prom/push"
# customer_prometheus_remote_write_username = "REPLACE_ME"
# customer_prometheus_remote_write_password = "REPLACE_ME"
