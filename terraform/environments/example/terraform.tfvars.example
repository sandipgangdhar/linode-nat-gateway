# terraform.tfvars.example (terraform/environments/example)
#
# Sample values for every required/commonly-changed variable in this
# example environment. Copy this file to terraform.tfvars (which is
# gitignored) and fill in real values before running terraform apply.
#
# -----------------------------------------------------
# Usage:
#
# Create a VPC + subnet yourself first (see "Bring your own VPC" below).
# cp terraform.tfvars.example terraform.tfvars
# # edit terraform.tfvars: real linode_token, ssh key, region, vpc_id,
# # public_subnet_id, password
# terraform init && terraform apply
#
# -----------------------------------------------------
# Best Practices:
#
# - Never commit the real terraform.tfvars (only this .example file is
#   meant to be checked in) -- it contains secrets once filled in.
# - Use a strong, unique root_pass and grafana_admin_password; both are
#   marked sensitive in variables.tf so Terraform will not print them in
#   plan/apply output.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------

# Copy to terraform.tfvars and fill in.

linode_token = "REPLACE_ME"
region        = "us-east"

# --------------------------------------------------------------------------
# Bring your own VPC -- REQUIRED. This automation no longer creates the
# VPC or its subnet(s) itself (v11 -- see terraform/modules/vpc/main.tf's
# header comment and docs/RUNBOOK.md "Bring your own VPC" for exactly how
# to create these first, e.g. via linode-cli):
#
#   linode-cli vpcs create --label lng-example --region us-east
#   linode-cli vpcs subnets-create <vpc_id> --label public-nat --ipv4 10.0.0.0/24
#
# public_subnet_id's CIDR needs enough headroom for every pool's
# private_ip_offset range -- 10.0.0.0/24 comfortably fits this example's
# shared (starts at .20) and dedicated-acme (starts at .50) pools.
# --------------------------------------------------------------------------
vpc_id           = 0 # REPLACE_ME with your VPC's numeric id
public_subnet_id = 0 # REPLACE_ME with your public subnet's numeric id

# Optional: only if some OTHER VPC-resident workload (e.g. an LKE
# Enterprise cluster's own private subnet) needs to reach natctl's roster
# API (port 8099) on the observability/control-plane host. This is a
# Cloud-Firewall concern, not a routing one -- terraform/modules/vpc/
# main.tf's control_plane firewall is default-deny (inbound_policy =
# "DROP"), so a subnet not listed here still gets its inbound connections
# to 8099 dropped. Listing a subnet's id below adds its real CIDR to that
# one firewall rule's allowlist (see data.linode_vpc_subnet.private + the
# natctl-api inbound block in that file) -- nothing else. It does NOT
# affect the NAT client fleet (that runs over VLAN, not VPC -- see
# docs/ARCHITECTURE.md §3.0) and does NOT add the subnet to the nat_node
# firewall. Leave as {} (the default) if nothing outside the
# NAT/observability nodes themselves needs to call that API.
#
# CORRECTED 2026-09-09 (found live): despite this comment's earlier
# claim, Linode does NOT automatically route a VPC-attached instance to
# any OTHER subnet in the same VPC -- only its own directly-connected one
# gets a kernel route; everything else falls through to the default
# route (out the PUBLIC interface, not the VPC) and is silently dropped,
# even once Cloud Firewall allows it here. This project now fixes that
# separately and automatically (every subnet in the VPC is auto-
# discovered via linode_vpc_subnets and routed into every node's eth1 --
# see terraform/modules/vpc's all_subnet_cidrs output) -- you do not need
# to do anything extra for routing itself, only decide which subnets
# should be allowed through the firewall, which is what private_subnet_ids
# below still controls.
# private_subnet_ids = {
#   "private-app-1"    = 0 # REPLACE_ME
#   "private-app-2"    = 0 # REPLACE_ME
#   "private-app-acme" = 0 # REPLACE_ME -- only if enable_dedicated_pool_example is true
# }

authorized_keys = [
  "ssh-ed25519 AAAA... you@example.com",
]

root_pass = "REPLACE_ME_WITH_A_STRONG_PASSWORD"

# --------------------------------------------------------------------------
# REQUIRED (roadmap/M2-security.md) -- no default, deliberately. Every
# firewall this environment creates (nat_node, control_plane, client) scopes
# SSH to exactly these CIDRs, and control_plane also scopes Grafana/
# Prometheus/Alertmanager (3000/9090/9093) to them. This used to default to
# 0.0.0.0/0 (open to the entire internet) with only a code comment telling
# an operator to fix it -- now you must set it explicitly. Use your own
# admin/office/VPN egress CIDR(s), e.g. a single IP as a /32.
# --------------------------------------------------------------------------
admin_cidrs = ["REPLACE_ME/32"] # e.g. ["203.0.113.4/32"]

# Terraform-managed floor for the shared pool. Start minimal (1) and raise
# it once real load justifies it; natctl also scales elastic capacity above
# this floor automatically, up to shared_pool_max_nodes — see
# docs/ARCHITECTURE.md §4.
shared_pool_floor_nodes = 1
shared_pool_max_nodes   = 12

# Set to false if you don't need a dedicated-capacity example pool.
enable_dedicated_pool_example = true

nat_instance_type = "g6-dedicated-4"

grafana_admin_password = "REPLACE_ME"

# --------------------------------------------------------------------------
# VLAN (private client fleet) -- see docs/ARCHITECTURE.md §3.0/§3.1.
# Every node in a pool joins the matching vlan_label as a member of this
# same L2 segment -- this is NOT a VPC subnet and has no separate
# Terraform resource (a VLAN is just a label + whatever CIDR every
# attached instance's ipam_address agrees to use).
#
# 2026-09-11 range-simplification refactor: two CIDRs per pool now,
# deliberately simple to reason about and to communicate to a customer:
#
#   vlan_cidr_shared          -- the FULL, real VLAN (e.g. a customer's
#                                 whole /16). Every node's interface is
#                                 actually configured with THIS prefix
#                                 length, so routing works across the
#                                 whole VLAN, including whatever a
#                                 customer's own automation does outside
#                                 this project's own corner of it.
#   vlan_cidr_shared_reserved -- a small sub-block NESTED inside the
#                                 above, wholly owned by this pool's own
#                                 floor+elastic nodes (and the
#                                 observability host, which also joins
#                                 this VLAN -- see below). Nothing else
#                                 (a customer's own clients, another pool
#                                 sharing the same physical VLAN) should
#                                 ever be assigned an address inside it --
#                                 tell the customer "everything from X
#                                 onward is yours" as a clean, round
#                                 boundary, rather than sizing this
#                                 precisely; generous slack here is
#                                 harmless.
#
# Defaults below reproduce this environment's original address layout, so
# leaving these commented out/unset changes nothing; override only if you
# need a different address space.
#
# vlan_cidr_shared and vlan_cidr_dedicated_acme are always allowed to
# overlap or nest -- separate VLAN labels are fully isolated L2 domains on
# Linode regardless of numeric CIDR overlap. When they're the SAME value
# (v13, "same-VLAN mode" -- e.g. one account-wide VLAN shared with VPN
# traffic), the only thing that needs coordinating is that
# vlan_cidr_shared_reserved and vlan_cidr_dedicated_acme_reserved don't
# overlap with EACH OTHER -- main.tf's "vlan_cidr_reserved_no_overlap_same_vlan"
# check enforces this at plan time.
#
# Example, same-VLAN mode:
#   vlan_label_shared                 = "lng-vlan-account"
#   vlan_cidr_shared                  = "10.128.0.0/12"
#   vlan_cidr_shared_reserved         = "10.128.0.0/24"
#   vlan_label_dedicated_acme         = "lng-vlan-account"   # SAME as vlan_label_shared
#   vlan_cidr_dedicated_acme          = "10.128.1.0/24"
#   vlan_cidr_dedicated_acme_reserved = "10.128.1.0/27"
# --------------------------------------------------------------------------
# vlan_label_shared                 = "lng-vlan-shared"
# vlan_cidr_shared                  = "192.168.100.0/22"
# vlan_cidr_shared_reserved         = "192.168.100.0/24" # nested inside vlan_cidr_shared above
# vlan_label_dedicated_acme         = "lng-vlan-acme"   # only relevant if enable_dedicated_pool_example is true
# vlan_cidr_dedicated_acme          = "192.168.105.0/24" # only relevant if enable_dedicated_pool_example is true
# vlan_cidr_dedicated_acme_reserved = "192.168.105.0/27" # nested inside vlan_cidr_dedicated_acme above

# --------------------------------------------------------------------------
# Reserved IPs -- see docs/ARCHITECTURE.md. Opt-in (default false). When
# true, every node's primary public IP (floor AND natctl-provisioned
# elastic nodes) is a Linode Reserved IP that survives an instance
# replacement -- turn this on if any downstream service IP-whitelists this
# fleet's egress addresses. Linode's Reserved IP feature is account-gated
# ("IP reservation is not currently available to all users") -- confirm
# it's enabled for your account before setting this true, or
# linode_networking_ip will fail outright on apply.
# --------------------------------------------------------------------------
# reserved_ip_enabled = true

# --------------------------------------------------------------------------
# Bring-your-own reserved IPs -- see docs/ARCHITECTURE.md §3.8.1 /
# roadmap/M17-reserved-ip-pool-and-prereservation.md. Opt-in, only
# meaningful when reserved_ip_enabled above is true. Addresses you
# ALREADY OWN (reused from a prior deployment on this account, or
# reserved out-of-band ahead of time) -- assigned BY POSITION to this
# pool's floor nodes (first entry -> first floor node by creation
# order, and so on). Any floor node beyond the length of this list
# still gets a freshly-created reservation, exactly as if this variable
# were left at its default []. Must not exceed the pool's floor node
# count -- Terraform fails plan loudly if it does, rather than silently
# leaving excess addresses unused. Every supplied address must actually
# be a Reserved IP you already own on this account/region.
# --------------------------------------------------------------------------
# shared_pool_reserved_ip_pool         = ["203.0.113.10", "203.0.113.11"]
# dedicated_acme_pool_reserved_ip_pool = ["203.0.113.20"]

# --------------------------------------------------------------------------
# Anti-affinity placement groups -- see docs/ARCHITECTURE.md §3.6.2 /
# roadmap/M16-anti-affinity-placement-groups.md. Opt-in (default false).
# When true, floor nodes are spread across Linode Placement Groups
# (anti_affinity:local) so Akamai avoids co-locating them on the same
# physical host -- closes the "correlated physical-host failure takes out
# both buddy pair members" gap docs/COMPARISON.md documents. Floor nodes
# only -- natctl-provisioned elastic nodes are not covered. A pool over 5
# floor nodes gets multiple groups (Akamai's 5-Linode-per-group cap) in
# contiguous creation-order blocks, which only fully protects pairs that
# land inside the same block -- see the roadmap file's "Residual gap".
# --------------------------------------------------------------------------
# placement_group_enabled = true
# placement_group_policy  = "strict" # or "flexible" -- see variables.tf

# --------------------------------------------------------------------------
# Object Storage -- REQUIRED (not opt-in), regardless of natctl_on_node_enabled
# below. terraform/modules/artifacts uploads exporter.py/buddy_sync.py/the
# natctl package here ONCE per apply, and every NAT node fetches them at
# boot instead of embedding their content directly in cloud-init --
# Linode's Instance Metadata API hard-caps user_data at 16384 bytes
# (decoded), and this project's own source files alone already exceed
# that with no other features enabled. See docs/ARCHITECTURE.md's
# "Fetched-at-boot artifacts" section and
# terraform/modules/artifacts/main.tf's header comment for the full
# numbers. The SAME bucket/keys also back the leader-election lease when
# natctl_on_node_enabled is true (see below) -- one bucket, dual purpose.
# Create the bucket yourself first (Cloud Manager, or `linode-cli
# object-storage bucket-create`) -- this project does not create it via
# Terraform.
# --------------------------------------------------------------------------
natctl_object_storage_endpoint   = "https://us-east-1.linodeobjects.com"
natctl_object_storage_bucket     = "lng-artifacts"
natctl_object_storage_access_key = "REPLACE_ME"
natctl_object_storage_secret_key = "REPLACE_ME"

# v6: natctl-on-node (opt-in) -- removes the requirement for a dedicated
# control-plane host by running natctl itself, leader-elected with STONITH
# fencing, on every NAT node instead. Leave commented out / false to keep
# the original single-dedicated-host layout (module.observability runs
# natctl). See docs/RUNBOOK.md's natctl-on-node section before enabling
# this in production -- fencing briefly interrupts a node's own NAT
# traffic, and this is defense-in-depth, not mathematically perfect
# mutual exclusion. Only this toggle is opt-in -- the Object Storage block
# above it is required either way (see its own comment).
#
# natctl_on_node_enabled = true

# v6: already have Prometheus/Grafana (or a remote-write-compatible
# backend)? Set this to false to skip provisioning this project's own copy
# entirely -- see docs/OBSERVABILITY.md "Bring your own monitoring". You
# can also keep run_monitoring_stack = true (the default) and just add
# customer_prometheus_remote_write_url to have the local Prometheus this
# environment provisions forward samples into your existing backend too.
#
# run_monitoring_stack                      = false
# customer_prometheus_remote_write_url      = "https://prometheus-blocks-prod-us-central1.grafana.net/api/prom/push"
# customer_prometheus_remote_write_username = "REPLACE_ME"
# customer_prometheus_remote_write_password = "REPLACE_ME"

# --------------------------------------------------------------------------
# roadmap/M20-remove-terraform-client-creation.md (2026-09-02): this
# environment no longer creates client instances via Terraform -- the
# v14/v15/v17.2 client_groups mechanism that used to be documented here
# is removed. A customer's own automation creates their client
# instances (their own Terraform, an autoscaling group, hand-provisioned
# -- this project has no opinion); scripts/configure-vlan-address.sh +
# scripts/install-nat-client.sh configure an already-existing instance to
# become a working client. See docs/RUNBOOK.md's "Onboard a client
# instance" section for the full walkthrough, including the four
# interface_mode equivalents and how client-agent gets installed.
#
# 2026-09-11: client_static_vlan_reserved (a per-pool reserved-address
# COUNT) is removed -- the VLAN block above already handles this more
# simply. A manually-assigned client's address just needs to fall
# OUTSIDE vlan_cidr_shared_reserved/vlan_cidr_dedicated_acme_reserved
# (anywhere else in vlan_cidr_shared/vlan_cidr_dedicated_acme) -- no
# separate reservation count to size or keep in sync.
# --------------------------------------------------------------------------
