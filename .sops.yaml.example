# .sops.yaml.example
#
# Copy this to .sops.yaml (repo root) and replace the placeholder age
# public key below with your own. Declares which file SOPS encrypts and
# which age public key(s) can decrypt it -- the public key is not
# sensitive (it's the whole point of asymmetric encryption) and is safe
# to commit; the matching private key never is.
#
# Generate your own keypair:
#   age-keygen -o ~/.config/sops/age/keys.txt
#   chmod 600 ~/.config/sops/age/keys.txt
#   age-keygen -y ~/.config/sops/age/keys.txt   # prints your PUBLIC key
#
# See docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html, Part VIII 8.3 for the full
# workflow: viewing/editing secrets.enc.json, onboarding a second
# operator, and the runtime secrets bundle this same keypair pattern
# also backs.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------
creation_rules:
  - path_regex: secrets\.enc\.json$
    age: age1REPLACE_WITH_YOUR_OWN_AGE_PUBLIC_KEY
