#cloud-config
# client-node.yaml.tftpl (ansible/cloud-init) -- CUSTOMER-REPO BINARY VARIANT
#
# This is the customer-repo-overlay equivalent of the dev repo's
# ansible/cloud-init/client-node.yaml.tftpl. The dev repo embeds
# client-agent's Python SOURCE directly (gzip+base64) because
# vlan_only/vpc_vlan instances have no internet path of their own until
# client-agent itself brings up the default route -- a real constraint
# this variant can't skip either. This
# variant keeps that same constraint in mind but fetches a pre-compiled
# client-agent BINARY instead of embedding Python source -- see
# controller/natctl/api.py's GET /agents/client-agent (served by natctl's
# own roster API, which a client instance CAN already reach over its
# VLAN/VPC connected route -- that route comes up automatically the
# moment the interface gets its static address, independent of
# client-agent -- see docs/NAT-GATEWAY-DEFINITIVE-GUIDE.html §3.3 for the
# underlying mechanism this depends on).
#
# A compiled binary is multi-MB -- far too large to embed the way source
# was (Linode's Instance Metadata API caps cloud-init user_data at 16384
# bytes decoded) -- so it MUST be fetched, not embedded, which is exactly
# what this variant does instead.
#
# IMPORTANT: this fetch step deliberately uses python3's stdlib
# (urllib.request), NOT curl -- python3 is guaranteed present on every
# Ubuntu cloud image (cloud-init itself requires it to run at all), but
# curl is NOT guaranteed present without an `apt-get install`, and
# apt-get during cloud-init's package-install phase needs internet access
# that a vlan_only/vpc_vlan instance doesn't have yet -- the exact same
# chicken-and-egg problem that made source-embedding necessary in the
# first place. Using python3 (already there) sidesteps that entirely,
# with no package install needed at all.
#
# -----------------------------------------------------
# Usage:
#
# - NOT currently rendered by any Terraform module in this repo (this
#   project no longer creates client instances at all -- your own
#   automation does, then runs scripts/install-nat-client.sh against it,
#   see docs/CLIENT-INSTALL-GUIDE.md). Kept here as a reference for
#   anyone who wants the same behaviors baked into their own instance's
#   boot process -- adapt it into your own `templatefile()` call,
#   supplying the variables referenced below (including
#   lng_client_agent_service_content) yourself.
# - Never edit this file's rendered output directly on a running
#   instance -- change your own template inputs and re-provision instead.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------

hostname: ${node_name}
ssh_pwauth: false

write_files:
  # Always written, regardless of enable_nat_egress -- every client
  # instance needs its own static VLAN IP. Filename prefix "00-" is
  # deliberate, not cosmetic -- see the dev repo's identical comment for
  # why (Akamai's own network stage writes a competing "05-eth<N>.network"
  # first; systemd-networkd applies only the lexically-first match).
  - path: /etc/systemd/network/00-lng-vlan.network
    owner: root:root
    permissions: '0644'
    content: |
      [Match]
      Name=${vlan_iface}

      [Network]
      Address=${static_vlan_ip}/${vlan_prefix}

%{ if enable_nat_egress ~}
  # enable_nat_egress (interface_mode "vlan_only"/"vpc_vlan"): this
  # instance has no internet path of its own, so client-agent takes over
  # the default route with ECMP across every healthy node in the pool.
  # Content shape matches client-agent/lng-client-agent.env.example.
  - path: /etc/lng-client-agent/env
    owner: root:root
    permissions: '0640'
    content: |
      NATCTL_ROSTER_URL=${natctl_roster_base_url}/fleet/${pool_name}
      LNG_PRIVATE_IFACE=${vlan_iface}
      LNG_ROSTER_POLL_INTERVAL=30
      LNG_HEALTH_PROBE_INTERVAL=3
      LNG_HEALTH_PROBE_TIMEOUT=1.5
      LNG_DRY_RUN=false

  # Fetching the client-agent BINARY alone isn't enough -- `systemctl
  # enable --now lng-client-agent` in runcmd below needs its systemd unit
  # to already exist on disk, or it fails with "Unit file
  # lng-client-agent.service does not exist" even though the binary
  # itself landed correctly. The unit file is tiny, static, and
  # non-secret, so -- unlike the binary itself -- there's no reason to
  # fetch it separately; just embed it directly, same as the VLAN network
  # config above. Content comes from client-agent/lng-client-agent.service
  # (the customer repo's own binary-mode unit, already checked into this
  # repo) -- whoever adapts this template into a real `templatefile()`
  # call supplies it as the lng_client_agent_service_content variable.
  - path: /etc/systemd/system/lng-client-agent.service
    owner: root:root
    permissions: '0644'
    content: |
      ${indent(6, lng_client_agent_service_content)}
%{ endif ~}

runcmd:
  - systemctl restart systemd-networkd

%{ if enable_nat_egress ~}
  - mkdir -p /opt/lng-client-agent
  # See this file's header comment for why python3's stdlib urllib is
  # used here instead of curl. Retries for ~a minute -- covers the real
  # ordering risk that natctl might not be listening yet the instant this
  # instance boots (unlikely, but a fresh environment's very first client
  # instance could plausibly race a still-booting observability host).
  - |
    python3 - <<'LNG_FETCH_CLIENT_AGENT'
    import os
    import time
    import urllib.request

    url = "${natctl_roster_base_url}/agents/client-agent"
    dest = "/opt/lng-client-agent/client-agent"
    last_exc = None
    for attempt in range(20):
        try:
            urllib.request.urlretrieve(url, dest)
            last_exc = None
            break
        except Exception as exc:  # noqa: BLE001 -- best-effort retry loop, not library code
            last_exc = exc
            time.sleep(3)
    if last_exc is not None:
        raise SystemExit(f"failed to fetch client-agent binary from {url}: {last_exc}")
    os.chmod(dest, 0o750)
    LNG_FETCH_CLIENT_AGENT
  - systemctl daemon-reload
  - systemctl enable --now lng-client-agent
%{ endif ~}

  - logger -t lng-cloud-init "LNG client node ${node_name} (pool=${pool_name}) bootstrap complete"
