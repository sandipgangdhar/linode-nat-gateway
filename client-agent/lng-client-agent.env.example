# lng-client-agent.env.example (client-agent)
#
# Reference for every environment variable lng_client_agent.py reads.
# install.sh writes the real /etc/lng-client-agent/env file for you from
# its --natctl-url/--iface flags -- use this file as documentation, or to
# hand-build an env file for a non-install.sh deployment path.
#
# -----------------------------------------------------
# Author:
# - Sandip Gangdhar
# - GitHub: https://github.com/sandipgangdhar
#
# (c) Linode-NAT-Gateway (LNG) | Developed by Sandip Gangdhar | 2026
# -----------------------------------------------------

# Copy to /etc/lng-client-agent/env on every private-subnet instance that
# needs NAT egress. install.sh does this for you if you point it at your
# natctl host and pool.

# natctl's fleet roster endpoint for the pool this instance's subnet is
# assigned to. "shared" unless this instance belongs to a tenant with a
# dedicated pool (see docs/ARCHITECTURE.md §4).
NATCTL_ROSTER_URL=http://10.0.0.5:8099/fleet/shared

# The interface this instance's private-subnet traffic egresses on. v4:
# VLAN (eth2), not VPC (eth1) -- see docs/ARCHITECTURE.md section 3.0 for
# why the private client fleet moved off VPC. Only override this if your
# instance's VLAN interface has a non-default name.
LNG_PRIVATE_IFACE=eth2

# M24 (roadmap/M24-scalable-roster-health-distribution.md): the old
# fixed-interval LNG_ROSTER_POLL_INTERVAL/LNG_HEALTH_PROBE_INTERVAL
# variables are retired -- this agent now long-polls natctl's roster
# endpoint (no fixed interval at all) and trusts natctl's own computed
# node health by default (zero direct probing of NAT nodes). This
# per-probe HTTP timeout is still meaningful -- only used when the
# opt-in fallback probe below is enabled.
LNG_HEALTH_PROBE_TIMEOUT=1.5
LNG_DRY_RUN=false

# M24: opt-in fallback direct-probe -- off by default (this agent trusts
# natctl's reported health fully). When enabled, a node is usable only
# if natctl reports it healthy AND this client's own direct /healthz
# probe agrees (AND, not OR) -- extra insurance for an operator who
# judges "full trust in natctl" unacceptable for their deployment. See
# docs/ARCHITECTURE.md §3.2 for why full trust is the safe default here
# (every NAT node and every client share one physical VLAN L2 segment).
# Can also be set/overridden fleet-wide, live, without restarting any
# client, via `natctl_cli set-client-config` -- see docs/RUNBOOK.md.
LNG_FALLBACK_PROBE_ENABLED=false
# Valid range 3-60 seconds -- rejected loudly (agent refuses to start)
# if set outside this range, not silently clamped.
LNG_FALLBACK_PROBE_INTERVAL=30
